digraph G { graph [bgcolor="white", rankdir=TB, label="Состояния токена обновления", labelloc=t, fontsize=20, fontname="DejaVu Sans"]; node [shape=box, style=rounded, fontname="DejaVu Sans", color="#64748b"]; edge [fontname="DejaVu Sans"]; A[label="Начало",shape=oval]; B[label="Active / действующий"]; C[label="Revoked / отозванный"]; D[label="Expired / истёкший"]; E[label="Конец",shape=oval]; A->B[label="Вход / выпуск"]; B->C[label="Выход или ротация"]; B->D[label="Истечение JWT"]; C->E; D->E;}