digraph G { graph [bgcolor="white", rankdir=LR, label="Варианты использования", labelloc=t, fontsize=20, fontname="DejaVu Sans"]; node [shape=box, style=rounded, fontname="DejaVu Sans", color="#64748b"]; edge [fontname="DejaVu Sans"]; G[label="Гость"]; U[label="Пользователь"]; A[label="Администратор"]; A->U[label="наследует права"]; F1[shape=ellipse,label="FR-1: Гость может зарегистрироваться по email и паролю."]; G->F1;F2[shape=ellipse,label="FR-2: Гость может войти в аккаунт."]; G->F2;F3[shape=ellipse,label="FR-3: Пользователь может выйти из аккаунта."]; U->F3;F4[shape=ellipse,label="FR-4: Пользователь может создать запись дневника с тегами."]; U->F4;F5[shape=ellipse,label="FR-5: Пользователь может просматривать свои записи."]; U->F5;F6[shape=ellipse,label="FR-6: Пользователь может редактировать свои записи."]; U->F6;F7[shape=ellipse,label="FR-7: Пользователь может удалять свои записи."]; U->F7;F8[shape=ellipse,label="FR-8: Пользователь может искать и фильтровать свои записи."]; U->F8;F9[shape=ellipse,label="FR-9: Пользователь может загружать, скачивать и удалять вложения к своим записям."]; U->F9;F10[shape=ellipse,label="FR-10: Администратор может создавать встречи."]; A->F10;}